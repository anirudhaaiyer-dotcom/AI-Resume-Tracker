# Neon (written by `neon link` / `neon deploy`)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production

# LLM - Google Gemini free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Email - Resend free tier (no verified domain => onboarding@resend.dev, own inbox only)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
EMAIL_OVERRIDE_TO=

# Dashboard password (username: kargo). Required on Vercel.
APP_PASSWORD=
